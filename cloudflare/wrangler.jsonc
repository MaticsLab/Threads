// Cloudflare Containers deployment for StitchForge.
//
// Deployed automatically by Cloudflare Workers Builds when the GitHub repo
// is connected (root directory: cloudflare, deploy command: npx wrangler deploy),
// or manually from this directory:  npm install && npx wrangler deploy
// Requires Workers Paid (Containers enabled).
{
  "name": "stitchforge",
  "main": "worker.js",
  "compatibility_date": "2025-06-20",

  // static files ship to Cloudflare's edge; the Worker serves /static/*
  // from here so those requests never touch the container
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "containers": [
    {
      "class_name": "StitchForgeContainer",
      // built from the repo's Dockerfile; the app listens on 8000 by default
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "standard"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STITCHFORGE", "class_name": "StitchForgeContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StitchForgeContainer"] }
  ],
  "observability": {
    "enabled": true
  }
}
